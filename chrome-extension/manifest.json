{
  "manifest_version": 3,
  "name": "Liscia Agent Panel",
  "version": "1.2.2",
  "description": "Lets your local Liscia Agent see and control web pages in Chrome, plus a chat side panel.",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "debugger",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Liscia Agent",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "minimum_chrome_version": "116"
}